[% USE raw %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: BookRS recommendations: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo; BookRS recommendations &rsaquo; Configuration</div>

<div class="main container-fluid">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      <h1>BookRS recommendations</h1>
      [% IF saved %]<div class="alert alert-info">Settings saved. The OPAC picks them up on the next page load.</div>[% END %]
      <form method="post" action="/cgi-bin/koha/plugins/run.pl">
        [% INCLUDE 'csrf-token.inc' %]
        <input type="hidden" name="class" value="[% CLASS %]"/>
        <input type="hidden" name="method" value="[% METHOD %]"/>
        <input type="hidden" name="op" value="cud-save"/>
        <fieldset class="rows">
          <ol>
            <li><label for="api_url">BookRS API URL: </label>
                <input type="url" id="api_url" name="api_url" size="60" value="[% api_url | html %]" required/>
                <span class="hint">The address patrons' browsers can reach, e.g. https://bookrs.yourlibrary.org. It must list this OPAC's origin in BOOKRS_ALLOWED_ORIGINS. If this Koha enforces a Content-Security-Policy, add this URL to its connect-src, or proxy the API under the OPAC's own hostname.</span></li>
            <li><label for="source_id">Source id: </label>
                <input type="text" id="source_id" name="source_id" size="6" value="[% source_id | html %]"/>
                <span class="hint">Which harvested catalogue this OPAC is (see /sources on the API). Leave blank for a single-library deployment.</span></li>
            <li><label for="limit">Suggestions per panel: </label>
                <input type="number" id="limit" name="limit" min="1" max="24" value="[% limit | html %]"/></li>
            <li><label for="min_score">Minimum similarity: </label>
                <input type="text" id="min_score" name="min_score" size="6" value="[% min_score | html %]"/>
                <span class="hint">0.55 suits a real catalogue. Lower it only on a small demo instance.</span></li>
            <li><label for="heading">Panel heading (optional): </label>
                <input type="text" id="heading" name="heading" size="40" value="[% heading | html %]"/>
                <span class="hint">Overrides the widget's own headings on record pages.</span></li>
          </ol>
        </fieldset>
        <fieldset class="action"><input type="submit" class="btn btn-primary" value="Save"/></fieldset>
      </form>
    </div>
  </div>
</div>
[% INCLUDE 'intranet-bottom.inc' %]
