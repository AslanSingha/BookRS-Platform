# Copy to .env and fill in. .env is git-ignored: it holds secrets.

# Koha's database, read-only. The account needs SELECT on biblio,
# biblioitems, items, ratings, reviews (and issues, old_issues for loans).
KOHA_DB_URL=mysql://USER:PASSWORD@kohadev-db-1:3306/koha_kohadev
# The platform's id for this library (GET /sources lists them).
BOOKRS_SOURCE_ID=

# Shared with the Koha plugin: the token it sends, and the key it hashes
# borrower numbers with. Long random strings; set once, keep.
BOOKRS_SERVICE_TOKEN=
BOOKRS_PATRON_SECRET=

# How often the scheduler reads Koha, embeds new books and retrains
# (30m, 6h, 1d, 2w, off), and how often a read is a full one.
BOOKRS_READ_EVERY=10m
BOOKRS_FULL_READ_EVERY=1d
BOOKRS_EMBED_EVERY=1h
BOOKRS_REFIT_EVERY=1d

# The OPAC's origin, for the OPAC script.
BOOKRS_ALLOWED_ORIGINS=http://localhost:8080

# The fixture only (tools/ucsd_full.py): where the UCSD source files are.
UCSD_DATAPREP_DIR=
UCSD_THESIS_DATA_DIR=
